# ==============================================================================
# TV B11 Mobile-First Academic Portal — Environment Template (.env.example)
# Copy this file to .env.local for local development or set in Render Environment
# ==============================================================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Asia/Colombo Timezone Guarantee
TZ=Asia/Colombo

# JWT Authentication Secret
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Supabase Production Database & Auth (Leave empty to use local fallback engine)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Default SuperAdmin Initial Setup
INITIAL_ADMIN_USERNAME=tvadminb11
INITIAL_ADMIN_PASSWORD="AdminSecurePassword#2026"
INITIAL_ADMIN_NAME="Television Studies Administrator"
INITIAL_ADMIN_EMAIL=admin@tvstudies.ucr.ac.lk

